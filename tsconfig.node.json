{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "outDir": "dist-electron",
    "rootDir": "electron",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["electron"]
}